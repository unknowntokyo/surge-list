#!name=时光倒数
#!desc=显示法定、民俗、国际与专属节日倒计时，支持官方调休放假数据、置顶节日与节日当天早上定时提醒。
#!author=unknownTokyo
#!category=工具
#!arguments=SMART_SORT:true,VIP_WEIGHT:true,NOTIFY:true,PINNED:-,CUSTOM_1:-,CUSTOM_2:-,CUSTOM_3:-,CUSTOM_4:-,CUSTOM_5:-,CUSTOM_6:-
#!arguments-desc=[参数说明]\n\n1. SMART_SORT：同天数冲突时是否按节日权重排序（true/false，默认 true）。\n2. VIP_WEIGHT：是否提升专属纪念日权重（true/false，默认 true；需配合 SMART_SORT=true 生效）。\n3. NOTIFY：是否在节日/专属纪念日首日发送系统提醒（默认 true；所有节日日期与首日均按北京时间 UTC+8 计算，每日设备本地 08:00 定时推送，北京时间 08:00 后刷新面板也会兜底补推）。\n4. PINNED：置顶节日名称，多项用顿号/中文逗号/斜杠分隔（如：春节、中秋节）；置顶行与各分类默认均展示最近 2 项（置顶超出 2 项以 … 折叠）。\n5. CUSTOM_1~6：最多 6 个专属纪念日，格式为「名称:日期」（也支持空格分隔；空格分隔时 L 前缀须紧贴日期，如 生日 L12/3），例如：老婆🎂:5/12、结婚日:2026/10/1、生日:L12/3（或 生日:农历12/3，每年农历小月无三十顺退廿九，暂不支持闰月）、一次性农历:L2026/12/3（不含小月顺退）；公历每年 2/29 自动计算至下一个闰年。\n\n注意：不使用的可选项保留默认 -（或填 无）即可；参数值请勿包含 & 或英文双引号 "。

[Panel]
Countdown = script-name=Countdown,update-interval=3600

[Script]
Countdown = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/unknowntokyo/surge-list/master/Surge/Countdown.js,argument="SMART_SORT={{{SMART_SORT}}}&VIP_WEIGHT={{{VIP_WEIGHT}}}&NOTIFY={{{NOTIFY}}}&PINNED={{{PINNED}}}&CUSTOM_1={{{CUSTOM_1}}}&CUSTOM_2={{{CUSTOM_2}}}&CUSTOM_3={{{CUSTOM_3}}}&CUSTOM_4={{{CUSTOM_4}}}&CUSTOM_5={{{CUSTOM_5}}}&CUSTOM_6={{{CUSTOM_6}}}"
Countdown-Notify = type=cron,cronexp="0 8 * * *",timeout=15,wake-system=true,script-path=https://raw.githubusercontent.com/unknowntokyo/surge-list/master/Surge/Countdown.js,argument="SMART_SORT={{{SMART_SORT}}}&VIP_WEIGHT={{{VIP_WEIGHT}}}&NOTIFY={{{NOTIFY}}}&PINNED={{{PINNED}}}&CUSTOM_1={{{CUSTOM_1}}}&CUSTOM_2={{{CUSTOM_2}}}&CUSTOM_3={{{CUSTOM_3}}}&CUSTOM_4={{{CUSTOM_4}}}&CUSTOM_5={{{CUSTOM_5}}}&CUSTOM_6={{{CUSTOM_6}}}"