#!name=TailRelay
#!desc=Tailscale 节点中继状态。
#!author=unknownTokyo
#!category=工具
#!requirement=CORE_VERSION>=6011000
#!arguments=POLICY:Tailscale,TITLE:TailRelay,ICON:point.3.connected.trianglepath.dotted,SHORT_NAME:true,AUTO_COLOR:true,COLOR:#FFCC00
#!arguments-desc=POLICY: Tailscale 代理策略名（勿含英文双引号、|&| 或以反斜杠结尾）\nTITLE: 面板显示标题（勿含英文双引号、|&| 或以反斜杠结尾）\nICON: SF Symbols 图标名称\nSHORT_NAME: 是否隐藏 .ts.net 后缀（true/false）\nAUTO_COLOR: 按连接类型自动变色（true/false）\nCOLOR: 关闭自动变色时的图标十六进制色值（默认 #FFCC00）

[Panel]
TailRelay = title="{{{TITLE}}}", content="加载中...", icon="{{{ICON}}}", script-name=TailRelay, update-interval=60

[Script]
TailRelay = type=generic, timeout=10, script-path=https://raw.githubusercontent.com/unknowntokyo/surge-list/master/Surge/TailRelay.js, argument="v2|POLICY={{{POLICY}}}|&|TITLE={{{TITLE}}}|&|ICON={{{ICON}}}|&|SHORT_NAME={{{SHORT_NAME}}}|&|AUTO_COLOR={{{AUTO_COLOR}}}|&|COLOR={{{COLOR}}}"