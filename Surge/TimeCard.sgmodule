#!name=时光倒数
#!desc=显示法定、民俗、国际与专属节日倒计时，支持官方调休放假数据、置顶节日与节日当天早上定时提醒。
#!category=工具
#!arguments=ENABLE_PRIORITY_SORT:true,ENABLE_EXCLUSIVE_WEIGHT:true,ENABLE_AUTO_THEME:true,ENABLE_NOTIFY:true,PINNED_HOLIDAY:-,EXCLUSIVE_NAME_1:-,EXCLUSIVE_DATE_1:-,EXCLUSIVE_NAME_2:-,EXCLUSIVE_DATE_2:-,EXCLUSIVE_NAME_3:-,EXCLUSIVE_DATE_3:-,EXCLUSIVE_NAME_4:-,EXCLUSIVE_DATE_4:-,EXCLUSIVE_NAME_5:-,EXCLUSIVE_DATE_5:-,EXCLUSIVE_NAME_6:-,EXCLUSIVE_DATE_6:-
#!arguments-desc=[参数说明]\n\n1. ENABLE_PRIORITY_SORT：是否按节日权重排序（true/false，默认 true）。\n2. ENABLE_EXCLUSIVE_WEIGHT：是否提升专属纪念日权重（true/false，默认 true）。\n3. ENABLE_AUTO_THEME：是否按今日节日(红)/放假或周末(绿)/工作日或补班(灰)切换面板图标颜色（默认 true）。\n4. ENABLE_NOTIFY：是否在节日/专属纪念日首日发送系统通知（默认 true；每日 08:00 定时推送，北京时间 08:00 后刷新面板亦会兜底或补推当日新增项）。\n5. PINNED_HOLIDAY：置顶节日名称，多项用顿号/中文逗号/斜杠分隔（如：春节、中秋节）；面板每分类默认展示最近 3 项。\n6. EXCLUSIVE_NAME_1~6 / EXCLUSIVE_DATE_1~6：最多 6 组专属纪念日，名称与日期成对生效；公历支持每年 M/D（如 5/20）与一次性 YYYY/M/D（如 2026/10/1）；农历支持每年 L12/3（或 农历12/3，小月无三十自动顺退廿九，暂不支持闰月）与一次性 L2026/12/3。\n\n注意：不使用的可选项保留默认 -（或填 无）即可；参数值请勿包含 & 或英文双引号 "。

[Panel]
TimeCard = script-name=TimeCard,update-interval=3600

[Script]
TimeCard = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/unknowntokyo/surge-list/master/Surge/TimeCard.js,argument="ENABLE_PRIORITY_SORT={{{ENABLE_PRIORITY_SORT}}}&ENABLE_EXCLUSIVE_WEIGHT={{{ENABLE_EXCLUSIVE_WEIGHT}}}&ENABLE_AUTO_THEME={{{ENABLE_AUTO_THEME}}}&ENABLE_NOTIFY={{{ENABLE_NOTIFY}}}&PINNED_HOLIDAY={{{PINNED_HOLIDAY}}}&EXCLUSIVE_NAME_1={{{EXCLUSIVE_NAME_1}}}&EXCLUSIVE_DATE_1={{{EXCLUSIVE_DATE_1}}}&EXCLUSIVE_NAME_2={{{EXCLUSIVE_NAME_2}}}&EXCLUSIVE_DATE_2={{{EXCLUSIVE_DATE_2}}}&EXCLUSIVE_NAME_3={{{EXCLUSIVE_NAME_3}}}&EXCLUSIVE_DATE_3={{{EXCLUSIVE_DATE_3}}}&EXCLUSIVE_NAME_4={{{EXCLUSIVE_NAME_4}}}&EXCLUSIVE_DATE_4={{{EXCLUSIVE_DATE_4}}}&EXCLUSIVE_NAME_5={{{EXCLUSIVE_NAME_5}}}&EXCLUSIVE_DATE_5={{{EXCLUSIVE_DATE_5}}}&EXCLUSIVE_NAME_6={{{EXCLUSIVE_NAME_6}}}&EXCLUSIVE_DATE_6={{{EXCLUSIVE_DATE_6}}}"

TimeCard-Notify = type=cron,cronexp="0 8 * * *",timeout=15,wake-system=true,script-path=https://raw.githubusercontent.com/unknowntokyo/surge-list/master/Surge/TimeCard.js,argument="ENABLE_PRIORITY_SORT={{{ENABLE_PRIORITY_SORT}}}&ENABLE_EXCLUSIVE_WEIGHT={{{ENABLE_EXCLUSIVE_WEIGHT}}}&ENABLE_AUTO_THEME={{{ENABLE_AUTO_THEME}}}&ENABLE_NOTIFY={{{ENABLE_NOTIFY}}}&PINNED_HOLIDAY={{{PINNED_HOLIDAY}}}&EXCLUSIVE_NAME_1={{{EXCLUSIVE_NAME_1}}}&EXCLUSIVE_DATE_1={{{EXCLUSIVE_DATE_1}}}&EXCLUSIVE_NAME_2={{{EXCLUSIVE_NAME_2}}}&EXCLUSIVE_DATE_2={{{EXCLUSIVE_DATE_2}}}&EXCLUSIVE_NAME_3={{{EXCLUSIVE_NAME_3}}}&EXCLUSIVE_DATE_3={{{EXCLUSIVE_DATE_3}}}&EXCLUSIVE_NAME_4={{{EXCLUSIVE_NAME_4}}}&EXCLUSIVE_DATE_4={{{EXCLUSIVE_DATE_4}}}&EXCLUSIVE_NAME_5={{{EXCLUSIVE_NAME_5}}}&EXCLUSIVE_DATE_5={{{EXCLUSIVE_DATE_5}}}&EXCLUSIVE_NAME_6={{{EXCLUSIVE_NAME_6}}}&EXCLUSIVE_DATE_6={{{EXCLUSIVE_DATE_6}}}"