#!name=Rewrite & Host
#!desc=Q-Search & ChangeUA & Host
#!author=unknownTokyo
#!category=自用

[Host]
# > Router Admin Panel
*.id.ui.direct = server:system
LinksysSmartWiFi.com = server:system
_hotspot_.m2m = server:system
amplifi.lan = server:system
falogin.cn = server:system
hiwifi.com = server:system
hotspot.cslwifi.com = server:system
instant.arubanetworks.com = server:system
leike.cc = server:system
mediarouter.home = server:system
melogin.cn = server:system
miwifi.com = server:system
moshujia.cn = server:system
myrouter.local = server:system
network.unifi.ui.com = server:system
orbilogin.com = server:system
p.to = server:system
peiluyou.com = server:system
phicomm.me = server:system
router.asus.com = server:system
router.synology.com = server:system
routerlogin.net = server:system
setmeup.arubanetworks.com = server:system
sila.razer.com = server:system
tendawifi.com = server:system
tplinklogin.net = server:system
tplinkwifi.net = server:system
tplogin.cn = server:system
unifi.local = server:system
unifi.ui.com = server:system
wifi.cmcc = server:system
www.LinksysSmartWiFi.com = server:system
www.miwifi.com = server:system
zte.home = server:system

# > Local DNS Mapping
localhost = 127.0.0.1
sub.store = 127.0.0.1

[URL Rewrite]
# > Google 搜索
^https?:\/\/(?:www\.)?google\.cn(\/search(?:[/?#].*)?)$ https://www.google.co.jp$1 307

# > Google 地图
^https?:\/\/(?:ditu|maps)\.google\.cn((?:[/?#].*)?)$ https://maps.google.com$1 307

# > Google 通用跳转
^https?:\/\/(?:www\.)?(?:g|google)\.cn((?:[/?#].*)?)$ https://www.google.co.jp$1 307

# > bd xxx (百度)
^https:\/\/duckduckgo\.com\/\?(?:(?!q=)[^&]*&)*q=bd(?:\+|%20)([^&]+)(?:&.*)?$ https://www.baidu.com/s?wd=$1 307

# > zh xxx (知乎)
^https:\/\/duckduckgo\.com\/\?(?:(?!q=)[^&]*&)*q=zh(?:\+|%20)([^&]+)(?:&.*)?$ https://www.zhihu.com/search?q=$1 307

# > ccn (App Store 临时切换至国区)
^https:\/\/duckduckgo\.com\/\?(?:(?!q=)[^&]*&)*q=ccn(?:&.*)?$ https://itunes.apple.com/WebObjects/MZStore.woa/wa/resetAndRedirect?dsf=143465&mt=8&url=/WebObjects/MZStore.woa/wa/viewSoftware?mt=8&id=1108187390&cc=cn&urlDesc 307

# > git xxx (GitHub)
^https:\/\/duckduckgo\.com\/\?(?:(?!q=)[^&]*&)*q=git(?:\+|%20)([^&]+)(?:&.*)?$ https://github.com/search?q=$1 307

# > wk xxx (Wikipedia 中文)
^https:\/\/duckduckgo\.com\/\?(?:(?!q=)[^&]*&)*q=wk(?:\+|%20)([^&]+)(?:&.*)?$ https://zh.wikipedia.org/wiki/$1 307

# > uus (App Store 临时切换至美区)
^https:\/\/duckduckgo\.com\/\?(?:(?!q=)[^&]*&)*q=uus(?:&.*)?$ https://itunes.apple.com/WebObjects/MZStore.woa/wa/resetAndRedirect?dsf=143441&mt=8&url=/WebObjects/MZStore.woa/wa/viewSoftware?mt=8&id=1108187390&cc=us&urlDesc 307

# > xxx（无指令默认为 Google 搜索）
^https:\/\/duckduckgo\.com\/\?(?:(?!q=)[^&]*&)*q=([^&]+)(?:&.*)?$ https://www.google.co.jp/search?q=$1&num=30 307

[Header Rewrite]
# > 百度（全站替换为简单搜索的UA）
http-request ^https?:\/\/(?!d\.pcs).*(?<!map)\.baidu\.com header-replace-regex User-Agent .+iPhone.+ "Mozilla/5.0 (iPhone; CPU iPhone OS 16_6 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 SearchCraft/3.10.0 (Baidu; P2 16.6)"

# > 知乎（部分替换为简单搜索的UA）
http-request ^https?:\/\/www\.zhihu\.com header-replace-regex User-Agent .+iPhone.+ "Mozilla/5.0 (iPhone; CPU iPhone OS 16_6 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 SearchCraft/3.10.0 (Baidu; P2 16.6)"

[MITM]
hostname = %APPEND% *.baidu.com, *.google.cn, duckduckgo.com, g.cn, www.zhihu.com, -*.apple.com, -*.bugsnag.com, -*.crashlytics.com, -*.facebook.com, -*.firebaseapp.com, -*.firebaseio.com, -*.github.com, -*.google.co.jp, -*.google.com, -*.icloud.com, -*.instagram.com, -*.mzstatic.com, -*.pstatp.com, -*.snssdk.com, -<ip-address>