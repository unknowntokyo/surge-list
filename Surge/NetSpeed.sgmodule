#!name=NetSpeed
#!desc=花里胡哨才是生产力 测试网络下载速度、延迟并根据速度和延迟改变图标和颜色，乌龟、兔子还是闪电？
#!author=unknownTokyo
#!category=工具
#!arguments=title:NetSpeed,policy:DIRECT,TEST_PACKET:3,timeout:8
#!arguments-desc=title 面板标题；policy 测速策略或策略组名（默认 DIRECT，填 - 跟随 Surge 规则分流）；TEST_PACKET 下行数据量(MB，iOS上限16/Mac上限64)；timeout 请求超时秒数（需小于模块脚本超时 10s）。参数值请勿包含 & 或 "。

[Panel]
NetSpeed = script-name=NetSpeed,update-interval=-1

[Script]
NetSpeed = type=generic,script-path=https://raw.githubusercontent.com/unknowntokyo/surge-list/master/Surge/NetSpeed.js,timeout=10,argument="title={{{title}}}&policy={{{policy}}}&TEST_PACKET={{{TEST_PACKET}}}&timeout={{{timeout}}}"